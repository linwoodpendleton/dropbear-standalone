+#define EMB_OSSH_BEGIN "-----BEGIN OPENSSH PRIVATE KEY-----"
+#define EMB_OSSH_END "-----END OPENSSH PRIVATE KEY-----"
+#define EMB_OSSH_MAGIC "openssh-key-v1"
