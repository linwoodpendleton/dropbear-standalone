+/* one SSH string, without the exits of buf_getstring() */
+static int emb_getstr(buffer *b, const unsigned char **s, unsigned int *len) {
+	unsigned int n;
+	if (b->len - b->pos < 4) {
+		return DROPBEAR_FAILURE;
+	}
+	n = buf_getint(b);
+	if (n > b->len - b->pos) {
+		return DROPBEAR_FAILURE;
+	}
+	*s = buf_getptr(b, n);
+	*len = n;
+	buf_incrpos(b, n);
+	return DROPBEAR_SUCCESS;
