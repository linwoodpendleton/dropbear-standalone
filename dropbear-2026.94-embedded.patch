+static int emb_read_ossh_key(buffer *file, sign_key *key, const char **why) {
+	buffer *blob = NULL;
+	const unsigned char *s, *pub, *priv;
+	unsigned int len, publen, privlen, i, n = 0;
+	unsigned long outlen;
+	int ret = DROPBEAR_FAILURE;
