+	*why = "malformed OpenSSH private key";
+	/* keep only the base64 text between the BEGIN and END lines */
+	for (i = strlen(EMB_OSSH_BEGIN); i < file->len && file->data[i] != '-'; i++) {
+		unsigned char c = file->data[i];
+		if (c == ' ' || c == '\t' || c == '\r' || c == '\n') {
+			continue;
+		}
+		file->data[n++] = c;
+	}
+	if (file->len - i < strlen(EMB_OSSH_END)
+			|| memcmp(&file->data[i], EMB_OSSH_END, strlen(EMB_OSSH_END)) != 0) {
+		goto out;
+	}
+	blob = buf_new(n + 4);
+	outlen = blob->size;
+	if (n == 0 || base64_decode(file->data, n, blob->data, &outlen) != CRYPT_OK) {
+		goto out;
+	}
+	buf_setlen(blob, outlen);
+
+	/* PROTOCOL.key: magic, cipher, kdf, kdf options, key count,
+	   public key, then the private section */
+	if (blob->len < sizeof(EMB_OSSH_MAGIC)
+			|| memcmp(blob->data, EMB_OSSH_MAGIC, sizeof(EMB_OSSH_MAGIC)) != 0) {
+		goto out;
+	}
+	buf_setpos(blob, sizeof(EMB_OSSH_MAGIC));
+	if (emb_getstr(blob, &s, &len) != DROPBEAR_SUCCESS) {
+		goto out;
+	}
+	if (!emb_streq(s, len, "none")) {
+		*why = "the key has a passphrase; remove it with 'ssh-keygen -p -N \"\" -f KEY' on a copy";
+		goto out;
+	}
+	if (emb_getstr(blob, &s, &len) != DROPBEAR_SUCCESS          /* kdf name */
+			|| emb_getstr(blob, &s, &len) != DROPBEAR_SUCCESS   /* kdf options */
+			|| blob->len - blob->pos < 4) {
+		goto out;
+	}
+	if (buf_getint(blob) != 1) {
+		*why = "only files with a single key are supported";
+		goto out;
+	}
+	if (emb_getstr(blob, &s, &len) != DROPBEAR_SUCCESS          /* public key */
+			|| emb_getstr(blob, &s, &len) != DROPBEAR_SUCCESS) { /* private section */
+		goto out;
+	}
+	/* continue inside the private section only */
+	buf_setlen(blob, (s - blob->data) + len);
+	buf_setpos(blob, s - blob->data);
+	if (blob->len - blob->pos < 8 || buf_getint(blob) != buf_getint(blob)) {
+		goto out;
+	}
+	if (emb_getstr(blob, &s, &len) != DROPBEAR_SUCCESS) {
+		goto out;
+	}
+	if (!emb_streq(s, len, "ssh-ed25519")) {
+		*why = "only ed25519 keys are supported by this build";
+		goto out;
+	}
+	if (emb_getstr(blob, &pub, &publen) != DROPBEAR_SUCCESS
+			|| emb_getstr(blob, &priv, &privlen) != DROPBEAR_SUCCESS
+			|| publen != CURVE25519_LEN || privlen != 2 * CURVE25519_LEN
+			|| memcmp(priv + CURVE25519_LEN, pub, CURVE25519_LEN) != 0) {
+		goto out;
+	}
+	key->ed25519key = m_malloc(sizeof(*key->ed25519key));
+	memcpy(key->ed25519key->priv, priv, CURVE25519_LEN);
+	memcpy(key->ed25519key->pub, pub, CURVE25519_LEN);
+	ret = DROPBEAR_SUCCESS;
+	*why = NULL;
+out:
+	if (blob) {
+		buf_burn_free(blob);
+	}
+	return ret;
+}
