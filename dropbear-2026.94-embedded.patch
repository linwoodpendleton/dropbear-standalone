+/* EMB: this binary takes its login credentials from the command line and
+   runs every session as the uid that started it. Running it with more
+   privileges than the caller has (setuid/setgid bit, or file capabilities
+   beyond CAP_NET_BIND_SERVICE for a non-root caller) would hand any local
+   user a privileged shell or file writer (built-in scp), so refuse. */
+static void emb_refuse_elevated(void) {
+	struct { unsigned int version; int pid; } hdr = { 0x20080522, 0 };
+	struct { unsigned int eff, perm, inh; } data[2];
+	unsigned int i;
+
+	if (getuid() != geteuid() || getgid() != getegid()) {
+		fprintf(stderr, "Refusing to run setuid/setgid\n");
+		exit(1);
+	}
+	if (getuid() == 0) {
+		return;
+	}
+	memset(data, 0, sizeof(data));
+	if (syscall(SYS_capget, &hdr, data) != 0) {
+		return; /* kernel without capabilities */
+	}
+	for (i = 0; i < 2; i++) {
+		/* bit 10 = CAP_NET_BIND_SERVICE (bind port 22 as non-root) */
+		if ((data[i].perm | data[i].eff) & ~(i == 0 ? (1u << 10) : 0u)) {
+			fprintf(stderr, "Refusing to run with capabilities other than "
+				"cap_net_bind_service\n");
+			exit(1);
+		}
+	}
+}
