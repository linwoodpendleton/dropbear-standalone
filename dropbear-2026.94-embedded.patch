+#if EMB_NO_DNS
+/* EMB: numeric-only replacements for getaddrinfo()/getnameinfo().
+ * Accepts NULL (wildcard with AI_PASSIVE, else loopback), "localhost",
+ * dotted IPv4 and IPv6 literals, and numeric ports. Results are IPv4
+ * first, then IPv6. */
+static struct addrinfo *emb_ai_new(int family, const struct addrinfo *hints,
+		unsigned int port, const void *addr) {
+	/* one allocation: addrinfo followed by the sockaddr */
+	struct addrinfo *ai = m_malloc(sizeof(struct addrinfo)
+			+ sizeof(struct sockaddr_storage));
+	struct sockaddr_storage *ss = (struct sockaddr_storage *)(ai + 1);
+
+	ai->ai_family = family;
+	ai->ai_socktype = (hints && hints->ai_socktype) ? hints->ai_socktype : SOCK_STREAM;
+	ai->ai_protocol = hints ? hints->ai_protocol : 0;
+	ai->ai_addr = (struct sockaddr *)ss;
+	if (family == AF_INET) {
+		struct sockaddr_in *sin = (struct sockaddr_in *)ss;
+		sin->sin_family = AF_INET;
+		sin->sin_port = htons(port);
+		memcpy(&sin->sin_addr, addr, 4);
+		ai->ai_addrlen = sizeof(*sin);
+	} else {
+		struct sockaddr_in6 *sin6 = (struct sockaddr_in6 *)ss;
+		sin6->sin6_family = AF_INET6;
+		sin6->sin6_port = htons(port);
+		memcpy(&sin6->sin6_addr, addr, 16);
+		ai->ai_addrlen = sizeof(*sin6);
+	}
+	return ai;
+}
+
+int emb_getaddrinfo(const char *node, const char *service,
+		const struct addrinfo *hints, struct addrinfo **res) {
+	int family = hints ? hints->ai_family : AF_UNSPEC;
+	int passive = hints && (hints->ai_flags & AI_PASSIVE);
+	unsigned int port = 0;
+	unsigned char a4[4], a6[16];
+	int have4 = 0, have6 = 0;
+	struct addrinfo *r4 = NULL, *r6 = NULL;
+
+	*res = NULL;
+	if (family != AF_UNSPEC && family != AF_INET && family != AF_INET6) {
+		return EAI_FAMILY;
+	}
+	if (service && m_str_to_uint(service, &port) == DROPBEAR_FAILURE) {
+		return EAI_SERVICE;
+	}
+	if (port > 65535) {
+		return EAI_SERVICE;
+	}
+
+	memset(a4, 0, sizeof(a4));
+	memset(a6, 0, sizeof(a6));
+	if (node == NULL || strcasecmp(node, "localhost") == 0) {
+		if (node || !passive) {
+			/* loopback */
+			a4[0] = 127; a4[3] = 1;
+			a6[15] = 1;
+		}
+		/* else wildcard: all zero */
+		have4 = have6 = 1;
+	} else if (inet_pton(AF_INET, node, a4) == 1) {
+		have4 = 1;
+	} else if (inet_pton(AF_INET6, node, a6) == 1) {
+		have6 = 1;
+	} else {
+		return EAI_NONAME;
+	}
+	if (family == AF_INET) {
+		have6 = 0;
+	} else if (family == AF_INET6) {
+		have4 = 0;
+	}
+	if (!have4 && !have6) {
+		return EAI_NONAME;
+	}
+	if (have4) {
+		r4 = emb_ai_new(AF_INET, hints, port, a4);
+	}
+	if (have6) {
+		r6 = emb_ai_new(AF_INET6, hints, port, a6);
+	}
+	if (r4) {
+		r4->ai_next = r6;
+		*res = r4;
+	} else {
+		*res = r6;
+	}
+	return 0;
+}
+
+void emb_freeaddrinfo(struct addrinfo *res) {
+	while (res) {
+		struct addrinfo *next = res->ai_next;
+		m_free(res);
+		res = next;
+	}
+}
+
+int emb_getnameinfo(const struct sockaddr *sa, socklen_t salen,
+		char *host, socklen_t hostlen, char *serv, socklen_t servlen, int flags) {
+	const void *addr;
+	unsigned int port;
+
+	if (flags & NI_NAMEREQD) {
+		return EAI_NONAME;
+	}
+	if (sa->sa_family == AF_INET && salen >= sizeof(struct sockaddr_in)) {
+		const struct sockaddr_in *sin = (const struct sockaddr_in *)sa;
+		addr = &sin->sin_addr;
+		port = ntohs(sin->sin_port);
+	} else if (sa->sa_family == AF_INET6 && salen >= sizeof(struct sockaddr_in6)) {
+		const struct sockaddr_in6 *sin6 = (const struct sockaddr_in6 *)sa;
+		addr = &sin6->sin6_addr;
+		port = ntohs(sin6->sin6_port);
+	} else {
+		return EAI_FAMILY;
+	}
+	if (host && hostlen && inet_ntop(sa->sa_family, addr, host, hostlen) == NULL) {
+		return EAI_OVERFLOW;
+	}
+	if (serv && servlen && snprintf(serv, servlen, "%u", port) >= (int)servlen) {
+		return EAI_OVERFLOW;
+	}
+	return 0;
+}
