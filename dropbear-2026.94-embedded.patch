+/* ---------------------------------------------------------------------
+ * EMB: single-user embedded mode helpers.
+ * Everything below only runs at startup, in the listening process.
+ * ------------------------------------------------------------------- */
+
+/* Relative paths are made absolute now: in background mode daemon() does
+   chdir("/") before host keys (-R), key files or the pid file are used. */
+static char *emb_abspath(const char *path) {
+	char cwd[PATH_MAX];
+	char *ret;
+	if (path[0] == '/' || path[0] == '~' || getcwd(cwd, sizeof(cwd)) == NULL) {
+		return m_strdup(path);
+	}
+	ret = m_malloc(strlen(cwd) + strlen(path) + 2);
+	sprintf(ret, "%s/%s", cwd, path);
+	return ret;
+}
+
+/* Reads a small secret file (password or hash). Strips one trailing
+   newline (\n or \r\n). Returns a malloced string. */
+static char *emb_read_secret_file(const char *path) {
+	buffer *b = buf_new(DROPBEAR_MAX_PASSWORD_LEN + 200);
+	char *ret = NULL;
+	unsigned int len;
+	struct stat st;
+
+	if (buf_readfile(b, path) != DROPBEAR_SUCCESS) {
+		dropbear_exit("Can't read '%s': %s", path, strerror(errno));
+	}
+	if (stat(path, &st) == 0 && (st.st_mode & (S_IRGRP | S_IROTH))) {
+		dropbear_log(LOG_WARNING, "'%s' is readable by group/others, chmod 600 it", path);
+	}
+	len = b->len;
+	if (len == b->size) {
+		dropbear_exit("'%s' is too long", path);
+	}
+	if (len > 0 && b->data[len-1] == '\n') {
+		len--;
+		if (len > 0 && b->data[len-1] == '\r') {
+			len--;
+		}
+	}
+	if (memchr(b->data, '\0', len) != NULL || memchr(b->data, '\n', len) != NULL) {
+		dropbear_exit("'%s' must contain a single line", path);
+	}
+	ret = m_malloc(len + 1);
+	memcpy(ret, b->data, len);
+	ret[len] = '\0';
+	buf_burn_free(b);
+	return ret;
+}
+
+/* Stores sha256(password) for a constant-time comparison later and wipes
+   the plaintext. arg points into argv (or the environment) and is wiped
+   in place so it no longer shows in /proc/<pid>/cmdline or environ. */
+static void emb_set_plain(char *arg) {
+	char *pw = arg;
+	size_t len;
+	hash_state hs;
+
+	if (arg[0] == '@') {
+		pw = emb_read_secret_file(&arg[1]);
+	}
+	len = strlen(pw);
+	if (len == 0) {
+		dropbear_exit("Empty password is not allowed");
+	}
+	if (len > DROPBEAR_MAX_PASSWORD_LEN) {
+		dropbear_exit("Password too long (max %d)", DROPBEAR_MAX_PASSWORD_LEN);
+	}
+	sha256_init(&hs);
+	sha256_process(&hs, (const unsigned char*)pw, len);
+	sha256_done(&hs, svr_opts.emb_plain_sha256);
+	m_burn(&hs, sizeof(hs));
+	svr_opts.emb_have_plain = 1;
+
+	if (pw != arg) {
+		m_burn(pw, len);
+		m_free(pw);
+	} else {
+		m_burn(arg, len);
+	}
+}
+
+/* -H hash or -H @file. Keeps a private copy and wipes a literal hash from
+   argv right away (ps, /proc/<pid>/cmdline: a hash can still be attacked
+   offline); a repeated -H replaces the earlier one, which is wiped too. */
+static void emb_set_hash(char *arg) {
+	if (svr_opts.emb_hash) {
+		m_burn(svr_opts.emb_hash, strlen(svr_opts.emb_hash));
+		m_free(svr_opts.emb_hash);
+	}
+	if (arg[0] == '@') {
+		svr_opts.emb_hash = emb_read_secret_file(&arg[1]);
+	} else {
+		svr_opts.emb_hash = m_strdup(arg);
+		m_burn(arg, strlen(arg));
+	}
+}
+
+static void emb_add_key(const char *key) {
+	size_t len = strlen(key);
+	if (svr_opts.emb_num_keys >= EMB_MAX_KEYS) {
+		dropbear_exit("Too many -k keys (max %d)", EMB_MAX_KEYS);
+	}
+	const char *sp = strchr(key, ' ');
+	/* same limits as an authorized_keys line; must start with a key type
+	   this build supports (key options like command= are not accepted) */
+	if (len < 10 || len > 3000 || strchr(key, '\n') || strchr(key, '\r')
+			|| sp == NULL
+			|| signkey_type_from_name(key, sp - key) == DROPBEAR_SIGNKEY_NONE) {
+		dropbear_exit("Bad -k public key '%s' (expected 'ssh-ed25519 AAAA... [comment]')", key);
+	}
+	svr_opts.emb_keys[svr_opts.emb_num_keys++] = m_strdup(key);
+}
+
+static void emb_add_keyfile(const char *file) {
+	if (svr_opts.emb_num_keyfiles >= EMB_MAX_KEYFILES) {
+		dropbear_exit("Too many -K files (max %d)", EMB_MAX_KEYFILES);
+	}
+	if (file[0] == '\0') {
+		dropbear_exit("Bad -K");
+	}
+	if (access(file, R_OK) != 0) {
+		dropbear_log(LOG_WARNING, "-K %s is not readable (yet): %s", file, strerror(errno));
+	}
+	svr_opts.emb_keyfiles[svr_opts.emb_num_keyfiles++] = emb_abspath(file);
+}
+
+/* Fill in user/home/shell/password defaults. Does not require any
+   passwd/shadow/group database: getpwnam()/getpwuid() are only used to
+   pick nicer defaults when an entry for our own uid happens to exist. */
+static void emb_finish_opts(void) {
+	struct passwd *pw = NULL;
+	uid_t uid = geteuid();
+	const char *home = NULL, *shell = NULL;
+	char *envpw = getenv(DROPBEAR_PASSWORD_ENV);
+
+	/* -U/-D/-s point into argv: keep our own copies, so that nothing in
+	   svr_opts depends on argv contents (parts of argv are wiped) */
+	if (svr_opts.emb_user) {
+		svr_opts.emb_user = m_strdup(svr_opts.emb_user);
+	}
+	if (svr_opts.emb_home) {
+		svr_opts.emb_home = m_strdup(svr_opts.emb_home);
+	}
+	if (svr_opts.emb_shell) {
+		svr_opts.emb_shell = m_strdup(svr_opts.emb_shell);
+	}
+
+	if (svr_opts.emb_user == NULL) {
+		pw = getpwuid(uid);
+		if (pw && pw->pw_name && pw->pw_name[0]) {
+			svr_opts.emb_user = m_strdup(pw->pw_name);
+		} else {
+			svr_opts.emb_user = m_strdup("root");
+		}
+	} else {
+		pw = getpwnam(svr_opts.emb_user);
+		if (pw && pw->pw_uid != uid) {
+			if (uid == 0) {
+				/* started as root by mistake: "-U alice" would give alice a
+				   root shell. Sessions always run as the server's uid. */
+				dropbear_exit("-U %s is uid %d, but this server runs as root and "
+					"would give it a root shell; start the server as %s instead",
+					svr_opts.emb_user, (int)pw->pw_uid, svr_opts.emb_user);
+			}
+			/* some other account: borrow nothing from it */
+			pw = NULL;
+		}
+	}
+	{
+		const char *c = svr_opts.emb_user;
+		if (*c == '\0' || *c == '-' || strlen(c) > MAX_USERNAME_LEN) {
+			dropbear_exit("Bad -U user name");
+		}
+		for (; *c; c++) {
+			if (!(ascii_isalnum(*c) || strchr("._-@", *c))) {
+				dropbear_exit("Bad -U user name (allowed: A-Z a-z 0-9 . _ - @)");
+			}
+		}
+	}
+
+	if (svr_opts.emb_home == NULL) {
+		if (pw && pw->pw_dir && pw->pw_dir[0]) {
+			home = pw->pw_dir;
+		} else {
+			home = getenv("HOME");
+		}
+		svr_opts.emb_home = m_strdup((home && home[0]) ? home : "/");
+	}
+	if (svr_opts.emb_shell == NULL) {
+		if (pw && pw->pw_shell && pw->pw_shell[0]) {
+			shell = pw->pw_shell;
+		} else {
+			shell = getenv("SHELL");
+		}
+		svr_opts.emb_shell = m_strdup((shell && shell[0]) ? shell : "/bin/sh");
+	}
+	if (access(svr_opts.emb_shell, X_OK) != 0) {
+		dropbear_log(LOG_WARNING, "Login shell '%s' is not executable: %s",
+				svr_opts.emb_shell, strerror(errno));
+	}
+
+	/* Password: -P / -H / $DROPBEAR_PASSWORD. The env var is always removed
+	   so it can never leak into login sessions. */
+	if (envpw) {
+		if (!svr_opts.emb_have_plain && !svr_opts.emb_hash) {
+			emb_set_plain(envpw);
+		} else {
+			m_burn(envpw, strlen(envpw));
+		}
+		unsetenv(DROPBEAR_PASSWORD_ENV);
+	}
+	if (svr_opts.emb_hash) {
+		/* already our own copy (emb_set_hash) */
+		const char *h = svr_opts.emb_hash;
+		const char *probe = NULL;
+		const char *lastdollar = NULL;
+		if (svr_opts.emb_have_plain) {
+			dropbear_exit("-P (or DROPBEAR_PASSWORD) and -H can't be used together");
+		}
+		/* Must be a modular crypt hash, and crypt() must accept it:
+		   hashing anything with it must give a result of the same shape. */
+		lastdollar = strrchr(h, '$');
+		probe = (h[0] == '$' && lastdollar && lastdollar != h) ? emb_crypt("probe", h) : NULL;
+		if (probe == NULL || strlen(probe) != strlen(h)
+				|| strncmp(probe, h, lastdollar - h + 1) != 0) {
+			dropbear_exit("Unsupported -H hash; use a $6$ (SHA-512) or $5$ (SHA-256) crypt hash, "
+				"and quote it with single quotes in the shell");
+		}
+		probe = emb_crypt("", h);
+		if (probe && strcmp(probe, h) == 0) {
+			dropbear_exit("-H is the hash of an empty password, which is not allowed");
+		}
+	}
+#if DROPBEAR_SVR_PUBKEY_AUTH
+	if (!svr_opts.emb_hash && !svr_opts.emb_have_plain
+			&& svr_opts.emb_num_keys == 0 && svr_opts.emb_num_keyfiles == 0) {
+		dropbear_log(LOG_WARNING, "No -P/-H/-k/-K given: only %s/.ssh/authorized_keys "
+			"can be used to log in", svr_opts.emb_home);
+	}
+#else
+	if (!svr_opts.emb_hash && !svr_opts.emb_have_plain) {
+		dropbear_exit("No password configured (-P or -H)");
+	}
+#endif
+	{
+		int i;
+		for (i = 0; i < svr_opts.num_hostkey_files; i++) {
+			char *old = svr_opts.hostkey_files[i];
+			svr_opts.hostkey_files[i] = emb_abspath(old);
+			m_free(old);
+		}
+		if (svr_opts.pidfile) {
+			svr_opts.pidfile = emb_abspath(svr_opts.pidfile);
+		}
+		/* -R creates the key later, per connection (svr-kex.c), but
+		   load_all_hostkeys() m_free()s every hostkey_files[] entry at
+		   startup: keep a private copy of the target path. */
+		if (svr_opts.num_hostkey_files > 0) {
+			svr_opts.emb_hostkey_file = m_strdup(svr_opts.hostkey_files[0]);
+		}
+	}
+	dropbear_log(LOG_INFO, "Login '%s' runs as uid %d gid %d, home %s, shell %s%s",
+		svr_opts.emb_user, (int)uid, (int)getegid(), svr_opts.emb_home,
+		svr_opts.emb_shell, uid == 0 ? " (ROOT)" : "");
+}
+
+/* Records an absolute path to our own binary so that "scp" requested by
+   a client can be served by the built-in scp applet, even when no scp is
+   installed and /proc is not mounted. */
+void emb_set_selfpath(const char *argv0) {
+	char buf[PATH_MAX];
+	ssize_t n;
+
+	n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+	if (n > 0 && buf[0] == '/') {
+		buf[n] = '\0';
+		if (strstr(buf, " (deleted)") == NULL) {
+			svr_opts.emb_selfpath = m_strdup(buf);
+			return;
+		}
+	}
+	if (argv0 == NULL || argv0[0] == '\0') {
+		return;
+	}
+	if (argv0[0] == '/') {
+		svr_opts.emb_selfpath = m_strdup(argv0);
+	} else if (strchr(argv0, '/')) {
+		char cwd[PATH_MAX];
+		if (getcwd(cwd, sizeof(cwd)) && strlen(cwd) + strlen(argv0) + 2 <= sizeof(buf)) {
+			snprintf(buf, sizeof(buf), "%s/%s", cwd, argv0);
+			svr_opts.emb_selfpath = m_strdup(buf);
+		}
+	} else {
+		/* search $PATH like execvp() does */
+		const char *path = getenv("PATH");
+		const char *p, *z;
+		if (!path) {
+			path = "/usr/local/bin:/bin:/usr/bin";
+		}
+		for (p = path; ; p = z + 1) {
+			size_t l;
+			z = strchr(p, ':');
+			if (!z) {
+				z = p + strlen(p);
+			}
+			l = z - p;
+			if (l > 0 && p[0] == '/' && l + strlen(argv0) + 2 <= sizeof(buf)) {
+				memcpy(buf, p, l);
+				buf[l] = '/';
+				strcpy(&buf[l+1], argv0);
+				if (access(buf, X_OK) == 0) {
+					svr_opts.emb_selfpath = m_strdup(buf);
+					break;
+				}
+			}
+			if (*z == '\0') {
+				break;
+			}
+		}
+	}
+}
