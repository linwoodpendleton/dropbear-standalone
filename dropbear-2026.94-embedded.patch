+/* EMB: scan one opened authorized_keys stream */
+static int checkpubkey_stream(FILE *authfile, const char *filename,
+		const char* keyalgo, unsigned int keyalgolen,
+		const unsigned char* keyblob, unsigned int keybloblen,
