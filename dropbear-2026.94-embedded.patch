+/* EMB: checkfileperm() on a path and each of its parent directories.
+   A sticky directory owned by us or root (like /tmp) is fine as a parent:
+   nobody else can rename or replace our file in it. */
+static int emb_checkpathperm(const char *path) {
+	char *p = m_strdup(path), *sep;
+	int ret = checkfileperm(p);
+	while (ret == DROPBEAR_SUCCESS && (sep = strrchr(p, '/')) != NULL) {
+		struct stat st;
+		if (sep == p) {
+			if (p[1] == '\0') {
+				break;
+			}
+			sep++;
+		}
+		*sep = '\0';
+		if (stat(p, &st) == 0 && S_ISDIR(st.st_mode) && (st.st_mode & S_ISVTX)
+				&& (st.st_uid == 0 || st.st_uid == ses.authstate.pw_uid)) {
+			continue;
+		}
+		ret = checkfileperm(p);
+	}
+	m_free(p);
+	return ret;
+}
